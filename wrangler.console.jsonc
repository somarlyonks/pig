{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pig-console",
	"main": "src/cloudflare/console/worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [{ "name": "CONSOLE", "class_name": "ConsoleDurableObject" }]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ConsoleDurableObject"]
		}
	],
	"vars": {
		// Set with: npx wrangler secret put PIG_CONSOLE_TOKEN -c wrangler.console.jsonc
		"PIG_CONSOLE_TABLE_PREFIX": "console_"
	},
	"observability": {
		"enabled": true
	}
}
