{
	"name": "pig-github-app",
	"version": "0.1.0",
	"description": "PiG \u2014 Pi-durable In GitHub. A durable GitHub App built on @earendil-works/pi-durable that makes pull requests, reviews code, and manages releases with Pi.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node --watch --env-file-if-exists=.env src/main.ts",
		"start": "node --env-file-if-exists=.env src/main.ts",
		"build": "tsc -p tsconfig.json",
		"start:dist": "node --env-file-if-exists=.env dist/main.js",
		"typecheck": "tsc -p tsconfig.check.json",
		"test": "node --test \"test/**/*.test.ts\"",
		"check": "npm run typecheck && npm test"
	},
	"keywords": [
		"github-app",
		"pi",
		"pi-durable",
		"ai",
		"code-review",
		"release-automation"
	],
	"license": "MIT",
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/rest": "^22.0.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^5.9.3"
	}
}
