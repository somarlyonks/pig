{
	"name": "pig-github-app",
	"version": "0.1.0",
	"description": "PiG \u2014 Pi-durable In GitHub. A durable GitHub App built on @earendil-works/pi-durable that makes pull requests, reviews code, and manages releases with Pi.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node --watch --env-file-if-exists=.env src/main.ts",
		"start": "node --env-file-if-exists=.env src/main.ts",
		"build": "tsc -p tsconfig.json",
		"start:dist": "node --env-file-if-exists=.env dist/main.js",
		"typecheck": "tsc -p tsconfig.check.json",
		"test": "node --test \"test/**/*.test.ts\"",
		"check": "npm run typecheck && npm run cf:typecheck && npm test",
		"cf:dev": "wrangler dev",
		"cf:deploy": "wrangler deploy",
		"cf:dry-run": "wrangler deploy --dry-run --outdir dist-cloudflare",
		"cf:typecheck": "tsc -p tsconfig.cloudflare.json",
		"runner": "node --env-file-if-exists=.env src/runner/main.ts",
		"runner:dist": "node --env-file-if-exists=.env dist/runner/main.js",
		"console:dev": "wrangler dev -c wrangler.console.jsonc",
		"console:deploy": "wrangler deploy -c wrangler.console.jsonc",
		"console:dry-run": "wrangler deploy -c wrangler.console.jsonc --dry-run --outdir dist-console",
		"doctor": "node --env-file-if-exists=.env src/doctor-cli.ts",
		"smoke": "node --env-file-if-exists=.env src/smoke-cli.ts"
	},
	"keywords": [
		"github-app",
		"pi",
		"pi-durable",
		"ai",
		"code-review",
		"release-automation"
	],
	"license": "MIT",
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/rest": "^22.0.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261109.1",
		"@types/node": "^24.19.2",
		"typescript": "^5.9.3",
		"wrangler": "^4.158.0"
	}
}
