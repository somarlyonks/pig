# --- Required ---
# GitHub App ID (Settings -> Developer settings -> GitHub Apps)
PIG_GITHUB_APP_ID=

# Path to the downloaded App private key. Resolved relative to the process CWD.
PIG_GITHUB_PRIVATE_KEY_PATH=./github-app.pem
# Alternatively, inline the key with escaped newlines:
# PIG_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# The App's webhook secret, configured on GitHub.
PIG_WEBHOOK_SECRET=

# --- App identity ---
# Slug from https://github.com/apps/<slug>. Defaults to pig.
PIG_APP_SLUG=pig

# --- Server and durable storage ---
PIG_PORT=8787
PIG_DATABASE_PATH=./data/pig.sqlite
PIG_WORKSPACE_ROOT=./data/workspaces
# SQLite table prefix. Keep it stable once data exists; changing it does not migrate.
PIG_TABLE_PREFIX=pig_
PIG_LOG_LEVEL=info
# Enables GET /api/jobs with Authorization: Bearer <token>.
# PIG_ADMIN_TOKEN=

# --- Agent ---
# provider/modelId, modelId, or either with a :thinking suffix.
# Examples: anthropic/claude-sonnet-4-5, sonnet:high, gpt-5.4:medium
# PIG_MODEL=
# PIG_THINKING=high
PIG_JOB_TIMEOUT_MINUTES=30

# --- Model credentials (read by pi-ai; provider variables, not the Pi CLI login) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# AWS_PROFILE= (and related Amazon Bedrock variables)
# GOOGLE_CLOUD_PROJECT= (and related Vertex AI variables)

# One process owns PIG_DATABASE_PATH at a time. Do not share it between instances.

# --- Optional coding runner for the Cloudflare full host ---
# Run `npm run runner` with these values, then set PIG_RUNNER_URL/PIG_RUNNER_TOKEN
# as Worker secrets on the Cloudflare side.
# PIG_RUNNER_PORT=8790
# PIG_RUNNER_TOKEN=
# PIG_RUNNER_WORKSPACE_ROOT=./data/runner

# --- Optional outbound console session ---
# Lets this PiG behind NAT poll an operator console instead of being reachable.
# The console issues the session token when the worker is registered as outbound.
# PIG_CONSOLE_URL=https://pig-console.<account>.workers.dev
# PIG_CONSOLE_WORKER_ID=pig-mac
# PIG_CONSOLE_SESSION_TOKEN=ses_...
# PIG_CONSOLE_REPOS=owner/name,owner/other

# --- Optional Cloudflare orchestration host ---
# The Worker uses Wrangler secrets instead of this file:
#   wrangler secret put PIG_GITHUB_APP_ID
#   wrangler secret put PIG_GITHUB_PRIVATE_KEY
#   wrangler secret put PIG_WEBHOOK_SECRET
#   wrangler secret put PIG_ADMIN_TOKEN
# PIG_APP_SLUG and PIG_TABLE_PREFIX live in wrangler.jsonc.
# See README "Serverless Cloudflare host".
