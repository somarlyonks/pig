# --- Required ---
# GitHub App ID (Settings -> Developer settings -> GitHub Apps)
PIG_GITHUB_APP_ID=

# Path to the downloaded App private key. Resolved relative to the process CWD.
PIG_GITHUB_PRIVATE_KEY_PATH=./github-app.pem
# Alternatively, inline the key with escaped newlines:
# PIG_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# The App's webhook secret, configured on GitHub.
PIG_WEBHOOK_SECRET=

# --- App identity ---
# Slug from https://github.com/apps/<slug>. Defaults to pig.
PIG_APP_SLUG=pig

# --- Server ---
PIG_PORT=8787
PIG_DATABASE_PATH=./data/pig.sqlite
PIG_WORKSPACE_ROOT=./data/workspaces
PIG_LOG_LEVEL=info
# Enables GET /api/jobs with Authorization: Bearer <token>.
# PIG_ADMIN_TOKEN=

# --- Agent ---
# PIG_MODEL=sonnet:high
# PIG_THINKING=high
PIG_PI_BIN=pi
PIG_MAX_CONCURRENCY=2
PIG_JOB_TIMEOUT_MINUTES=30

# Lease and heartbeat tuning; values are seconds.
# PIG_HEARTBEAT_SECONDS=20
# PIG_LEASE_SECONDS=120

# --- Model credentials (passed through to Pi) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
